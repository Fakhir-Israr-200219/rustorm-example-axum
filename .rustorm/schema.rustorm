// RustORM E2E Test Schema
// Covers: CRUD, 1:1, 1:N, N:1, M2M, @map, @default, unique, nested loading

model User {
    id        Int       @id @default(autoincrement())
    name      String
    email     String    @unique
    age       Int
    bio       String?   @map("user_bio")
    createdAt DateTime  @default(now()) @map("created_at")

    profile   UserProfile?
    posts     Post[]
}

model UserProfile {
    id      Int     @id @default(autoincrement())
    avatar  String?
    website String?
    userId  Int     @unique
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)  // ← ADD
}

model Post {
    id        Int       @id @default(autoincrement())
    title     String
    content   String?
    published Boolean   @default(false)
    viewCount Int       @default(0) @map("view_count")
    userId    Int       @map("user_id")
    createdAt DateTime  @default(now()) @map("created_at")

    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade) 
    comments  Comment[]
    tags      Tag[]     @relation(through: "post_tags", pivotFrom: "post_id", pivotTo: "tag_id")
}

model Comment {
    id        Int       @id @default(autoincrement())
    body      String
    postId    Int       @map("post_id")
    authorId  Int       @map("author_id")
    createdAt DateTime  @default(now()) @map("created_at")

    post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)   // ← ADD
    author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade) // ← ADD
}

model Tag {
    id    Int     @id @default(autoincrement())
    name  String  @unique
    posts Post[]  @relation(through: "post_tags", pivotFrom: "tag_id", pivotTo: "post_id")
}

// ✅ PIVOT TABLE — Explicit model so CLI generates migration
// ✅ PIVOT TABLE — Simple id + unique constraint instead of composite @@id
model PostTag {
    id     Int @id @default(autoincrement())
    postId Int @map("post_id")
    tagId  Int @map("tag_id")

    post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
    tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@unique([postId, tagId])
    @@map("post_tags")
}